# ============================================================================
# Suara Fajar Deliksari — Environment Configuration Template
# Duplicate this file to .env.local and fill in your actual credentials.
# ============================================================================

# ── LiveKit (WebRTC Audio Streaming) ─────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ── Supabase (Database & Realtime) ───────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Application Configuration ────────────────────────────────────────────────
NEXT_PUBLIC_ROOM_NAME=suara-fajar-deliksari
ADMIN_PIN=9900
ADMIN_SESSION_SECRET=generate_a_random_32_byte_secret_here
YOUTUBE_API_KEY=your_optional_youtube_api_key
